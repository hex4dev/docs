---
import documents from '../data/generated-documents.json';
import { siteUrl } from '../utils/urls.js';
import '../styles/global.css';

const diaries = documents.filter((document) => document.category === 'Diario di bordo');
const dateLabel = (date) => date ? date.replaceAll('-', '/') : '';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Archivio dei diari di bordo del gruppo 14 — hex4dev." />
    <meta name="theme-color" content="#554AB6" />
    <title>Diari di bordo | hex4dev</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="https://github.com/hex4dev" target="_blank" rel="noopener noreferrer" aria-label="Organizzazione GitHub hex4dev">
          <img src={siteUrl('assets/hex4dev_logo.png')} alt="" width="80" height="80" />
          <span>hex4dev</span>
        </a>
        <a class="repository-link" href="https://github.com/hex4dev/docs" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </header>

    <main>
      <section class="page-heading" aria-labelledby="page-title">
        <p><a href={siteUrl('')}>← Torna ai documenti</a></p>
        <h1 id="page-title">Diari di bordo</h1>
      </section>

      <section class="archive" aria-labelledby="archive-title">
        <div class="archive-heading">
          <h2 id="archive-title">Archivio</h2>
          <span class="document-count" aria-live="polite"><span id="result-count">{diaries.length}</span> {diaries.length === 1 ? 'diario' : 'diari'}</span>
        </div>

        <div class="controls">
          <div class="search-field">
            <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4 4" /></svg>
            <label class="visually-hidden" for="diary-search">Cerca nei diari di bordo</label>
            <input id="diary-search" type="search" placeholder="Cerca nei diari di bordo" autocomplete="off" />
          </div>
        </div>

        <div class="document-list" id="diary-list">
          {diaries.map((document) => (
            <article class="document-row" data-diary data-search={`${document.title} ${document.date ?? ''} ${dateLabel(document.date)}`.toLocaleLowerCase('it-IT')}>
              <div class="document-main">
                <div class="document-title-line"><h2 class="diary-title">{document.title}</h2></div>
                {document.date && <p class="document-meta"><time datetime={document.date}>{dateLabel(document.date)}</time></p>}
              </div>
              <div class="document-actions" aria-label={`Azioni per ${document.title}`}>
                <a class="action-link action-primary" href={siteUrl(document.pdfPath)} target="_blank" rel="noopener noreferrer">Apri</a>
              </div>
            </article>
          ))}
        </div>

        <p class="empty-state" id="empty-state" hidden>{diaries.length ? 'Nessun diario trovato.' : 'Non ci sono ancora diari di bordo.'}</p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner"><span>hex4dev · Gruppo 14</span></div>
    </footer>
  </body>
</html>

<script>
  const input = document.querySelector('#diary-search');
  const cards = [...document.querySelectorAll('[data-diary]')];
  const count = document.querySelector('#result-count');
  const emptyState = document.querySelector('#empty-state');

  function filterDiaries() {
    const query = input.value.trim().toLocaleLowerCase('it-IT');
    let visibleCount = 0;
    for (const card of cards) {
      const visible = card.dataset.search.includes(query);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }
    count.textContent = String(visibleCount);
    emptyState.hidden = visibleCount !== 0;
  }

  input.addEventListener('input', filterDiaries);
</script>
