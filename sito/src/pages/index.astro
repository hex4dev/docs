---
import documents from '../data/generated-documents.json';
import sectionConfig from '../data/generated-sections.json';
import teamMembers from '../data/team-members.json';
import { siteUrl } from '../utils/urls.js';
import '../styles/global.css';

const categories = [...new Set(documents.map((document) => document.category))].sort((a, b) => {
  const aPinned = sectionConfig.pinnedCategories.indexOf(a);
  const bPinned = sectionConfig.pinnedCategories.indexOf(b);
  if (aPinned !== -1 || bPinned !== -1) {
    if (aPinned === -1) return 1;
    if (bPinned === -1) return -1;
    return aPinned - bPinned;
  }
  return a.localeCompare(b, 'it');
});
const featuredDocuments = documents.filter((document) => document.placement === 'above-archive');
const archiveDocuments = documents.filter((document) => document.placement !== 'above-archive');
const categoryGroups = categories.map((category) => ({
  category,
  documents: archiveDocuments.filter((document) => document.category === category),
})).filter((group) => group.documents.length);
const dateLabel = (date) => date ? date.replaceAll('-', '/') : '';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Documentazione del gruppo 14 — hex4dev." />
    <meta name="theme-color" content="#554AB6" />
    <title>Documentazione | hex4dev</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="https://github.com/hex4dev" target="_blank" rel="noopener noreferrer" aria-label="Organizzazione GitHub hex4dev">
          <img src={siteUrl('assets/hex4dev_logo.png')} alt="" width="80" height="80" />
          <span>hex4dev</span>
        </a>
        <a class="repository-link" href="https://github.com/hex4dev/docs" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </header>

    <main>
      <section class="page-heading" aria-labelledby="page-title">
        <h1 id="page-title">Documentazione</h1>
      </section>

      <section class="team-panel" aria-labelledby="team-title">
        <div class="team-panel-heading">
          <h2 id="team-title">Il gruppo</h2>
        </div>
        <ul class="team-members">
          {teamMembers.map((member) => (
            <li>
              <span class="member-name">{member.name}</span>
              <a href={`https://github.com/${encodeURIComponent(member.github)}`} target="_blank" rel="noopener noreferrer" aria-label={`Profilo GitHub di ${member.name}`}>
                @{member.github}
              </a>
              {member.status && <span class="member-status">{member.status}</span>}
            </li>
          ))}
        </ul>
        <div class="team-contact">
          <span>Contatto</span>
          <a href="mailto:hex4dev@gmail.com">hex4dev@gmail.com</a>
        </div>
      </section>

      <nav class="section-nav" aria-label="Sezioni" data-default-section={sectionConfig.defaultSection}>
        {sectionConfig.sections.map((section) => (
          <button class:list={['section-button', section.id === sectionConfig.defaultSection && 'is-active']} type="button" data-section={section.id} aria-pressed={section.id === sectionConfig.defaultSection ? 'true' : 'false'}>{section.title}</button>
        ))}
      </nav>

      <section class="archive" aria-labelledby="archive-title">
        <div class="archive-heading">
          <h2 id="archive-title">Documenti</h2>
          <span class="document-count" aria-live="polite"><span id="result-count">{documents.length}</span> {documents.length === 1 ? 'documento' : 'documenti'}</span>
        </div>

        <div class="controls">
          <div class="search-field">
            <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4 4" /></svg>
            <label class="visually-hidden" for="document-search">Cerca per titolo, categoria o data</label>
            <input id="document-search" type="search" placeholder="Cerca per titolo, categoria o data" autocomplete="off" />
          </div>
        </div>

        {featuredDocuments.map((document) => (
          <article class="featured-document" data-document data-section={document.section} data-category={document.category} data-search={`${document.title} ${document.category} ${document.type} ${document.date ?? ''} ${dateLabel(document.date)}`.toLocaleLowerCase('it-IT')}>
            <div class="document-title-line"><h2>{document.title}</h2>{document.version && <span class="version-badge">v{document.version}</span>}</div>
            <div class="document-actions" aria-label={`Azioni per ${document.title}`}>
              <a class="action-link action-primary" href={siteUrl(document.pdfPath)} target="_blank" rel="noopener noreferrer">Apri</a>
            </div>
          </article>
        ))}

        <div class="document-list" id="document-list">
          {categoryGroups.map(({ category, documents: categoryDocuments }) => (
            <section class="category-group" data-category-group={category} aria-label={category}>
              <h3>{category}</h3>
              {categoryDocuments.map((document) => (
                <article class="document-row" data-document data-section={document.section} data-category={document.category} data-search={`${document.title} ${document.category} ${document.type} ${document.date ?? ''} ${dateLabel(document.date)}`.toLocaleLowerCase('it-IT')}>
                  <div class="document-main">
                    <div class="document-title-line"><h4>{document.title}</h4>{document.version && <span class="version-badge">v{document.version}</span>}</div>
                    {document.date && <p class="document-meta"><time datetime={document.date}>{dateLabel(document.date)}</time></p>}
                  </div>
                  <div class="document-actions" aria-label={`Azioni per ${document.title}`}>
                    <a class="action-link action-primary" href={siteUrl(document.pdfPath)} target="_blank" rel="noopener noreferrer">Apri</a>
                  </div>
                </article>
              ))}
            </section>
          ))}
        </div>

        <p class="empty-state" id="empty-state" hidden>Nessun documento trovato.</p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>hex4dev · Gruppo 14</span>
      </div>
    </footer>
  </body>
</html>

<script>
  const input = document.querySelector('#document-search');
  const sectionButtons = [...document.querySelectorAll('.section-nav button[data-section]')];
  const cards = [...document.querySelectorAll('[data-document]')];
  const categoryGroups = [...document.querySelectorAll('[data-category-group]')];
  const count = document.querySelector('#result-count');
  const emptyState = document.querySelector('#empty-state');
  let activeSection = document.querySelector('.section-nav').dataset.defaultSection;

  function filterDocuments() {
    const query = input.value.trim().toLocaleLowerCase('it-IT');
    let visibleCount = 0;
    for (const card of cards) {
      const visible = card.dataset.section === activeSection && card.dataset.search.includes(query);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }
    for (const group of categoryGroups) {
      group.hidden = !group.querySelector('[data-document]:not([hidden])');
    }
    count.textContent = String(visibleCount);
    emptyState.hidden = visibleCount !== 0;
  }

  for (const button of sectionButtons) {
    button.addEventListener('click', () => {
      activeSection = button.dataset.section;
      for (const candidate of sectionButtons) {
        const selected = candidate === button;
        candidate.classList.toggle('is-active', selected);
        candidate.setAttribute('aria-pressed', String(selected));
      }
      filterDocuments();
    });
  }

  input.addEventListener('input', filterDocuments);
</script>
