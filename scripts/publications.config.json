{
  "defaultSection": "rtb",
  "pinnedCategories": {
    "candidatura": ["Dichiarazione impegni", "Valutazione capitolati"],
    "rtb": []
  },
  "pinnedDocuments": {
    "candidatura": ["lettera-di-presentazione"],
    "rtb": []
